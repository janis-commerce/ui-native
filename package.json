{
	"name": "@janiscommerce/ui-native",
	"version": "2.6.1",
	"description": "components library for Janis app",
	"main": "dist/index.js",
	"typings": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"android": "node scripts/set-app-mode.js app && react-native run-android",
		"ios": "node scripts/set-app-mode.js app && react-native run-ios",
		"storybook:android": "node scripts/set-app-mode.js storybook && sb-rn-get-stories --config-path .ondevice --use-js && react-native run-android",
		"storybook:ios": "node scripts/set-app-mode.js storybook && sb-rn-get-stories --config-path .ondevice --use-js && react-native run-ios",
		"start": "react-native start",
		"test": "jest",
		"lint": "eslint .",
		"prepare": "husky install",
		"validate:code": "npm run lint -- --fix && tsc --project tsconfig.build.json --noEmit && npm t",
		"test:commit": "jest --colors --bail --passWithNoTests --findRelatedTests",
		"test:coverage": "tsc --noEmit && jest --collectCoverage --detectOpenHandles",
		"build": "rm -rf dist && tsc --project tsconfig.build.json && cp -r android ios dist && tsc-alias -p tsconfig.aliases.json",
		"update-stories": "sb-rn-get-stories --config-path .ondevice --use-js",
		"storybook-web": "node scripts/set-app-mode.js web && storybook dev -p 6006 -c .storybook",
		"storybook-web-build": "node scripts/set-app-mode.js web && storybook build -c .storybook -o .storybook_static",
		"storybook-web-docs": "node scripts/set-app-mode.js web && storybook build -c .storybook -o docs",
		"preversion": "npm run test:coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/janis-commerce/ui-native.git"
	},
	"keywords": [
		"janis",
		"app",
		"ui"
	],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/janis-commerce/ui-native/issues"
	},
	"homepage": "https://github.com/janis-commerce/ui-native#readme",
	"peerDependencies": {
		"react": ">=17.0.2 <20.0.0",
		"react-native": ">=0.71.5 <0.82.0",
		"react-native-gesture-handler": ">=2.18.0",
		"react-native-fast-image": "^8.5.11",
		"react-native-reanimated": ">=3.16.0",
		"react-native-toast-message": ">=1.6.0",
		"react-native-svg": ">=12.0.0",
		"react-native-safe-area-context": ">=4.6.0",
		"react-native-date-picker": ">=5.0.0",
		"@react-native-async-storage/async-storage": ">=1.19.0"
	},
	"devDependencies": {
		"@babel/core": "^7.12.9",
		"@babel/preset-env": "^7.22.7",
		"@babel/runtime": "^7.22.6",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/cli": "19.1.2",
		"@react-native-community/cli-platform-android": "19.1.2",
		"@react-native-community/cli-platform-ios": "19.1.2",
		"@react-native-community/datetimepicker": "9.2.2",
		"@react-native-community/eslint-config": "^2.0.0",
		"@react-native/babel-preset": "0.80.3",
		"@react-native/metro-config": "0.80.3",
		"@storybook/addon-docs": "10.6.3",
		"@storybook/addon-ondevice-actions": "10.7.0",
		"@storybook/addon-ondevice-controls": "10.7.0",
		"@storybook/react-native": "10.7.0",
		"@storybook/react-native-web-vite": "10.6.3",
		"@testing-library/react-native": "^13.3.3",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.9.0",
		"@types/react": "^19.1.0",
		"@types/react-native-vector-icons": "^6.4.14",
		"@types/react-test-renderer": "^19.1.0",
		"@typescript-eslint/eslint-plugin": "^5.45.0",
		"@typescript-eslint/parser": "^5.32.0",
		"babel-jest": "^29.7.0",
		"eslint": "^7.14.0",
		"eslint-config-airbnb": "^18.2.1",
		"eslint-config-airbnb-typescript": "^17.0.0",
		"eslint-config-prettier": "^8.1.0",
		"eslint-import-resolver-babel-module": "^5.2.0",
		"eslint-plugin-react": "^7.30.1",
		"eslint-plugin-react-hooks": "^4.6.0",
		"eslint-plugin-react-native": "^4.0.0",
		"eslint-plugin-storybook": "^0.6.12",
		"husky": "^8.0.0",
		"jest": "^29.7.0",
		"lint-staged": "^13.0.3",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-native": "0.80.3",
		"react-native-date-picker": "5.0.13",
		"react-native-fast-image": "8.7.0",
		"react-native-gesture-handler": "2.31.2",
		"react-native-reanimated": "3.19.5",
		"react-native-safe-area-context": "5.7.0",
		"react-native-svg": "15.8.0",
		"react-native-toast-message": "2.3.3",
		"react-native-web": "^0.21.4",
		"react-test-renderer": "19.1.0",
		"setup-env": "^2.0.0",
		"storybook": "10.6.3",
		"tsc-alias": "^1.8.10",
		"typescript": "^5.1.6",
		"vite": "^7.1.0"
	},
	"lint-staged": {
		"*{js,jsx,ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{js,jsx,ts,tsx}": [
			"npm run test:commit"
		],
		"*.{ts,tsx}": [
			"bash -c tsc --noEmit"
		]
	},
	"dependencies": {
		"@gorhom/bottom-sheet": "^4.6.3",
		"@react-native-community/slider": "^4.4.2",
		"babel-plugin-module-resolver": "^5.0.2",
		"react-native-vector-icons": "^9.2.0"
	}
}
